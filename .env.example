# Local sandbox only. Copy to .env; never commit the real .env.
NODE_ENV=development
DATABASE_URL=file:./latchwork.db
PORT=4000
GATEWAY_PORT=4001
TEST_SERVICE_PORT=4002
MONITOR_PORT=4003
HOST=127.0.0.1
ALLOW_LOCAL_UPSTREAMS=true
XLAYER_RPC_URL=https://rpc.xlayer.tech
XLAYER_CHAIN_ID=196
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_GATEWAY_URL=http://localhost:4001
NEXT_PUBLIC_MONITOR_URL=http://localhost:4003
# Production requires separately generated secrets and signing keys.
# JWT_SECRET=
# MONITOR_API_TOKEN=
# GATEWAY_SIGNER_PRIVATE_KEY=
# WITNESS_1_PRIVATE_KEY=
# WITNESS_2_PRIVATE_KEY=
# WITNESS_3_PRIVATE_KEY=
# No deployment key is needed for local tests or the public preview.
